# A browser-restricted Google Maps JavaScript API key enables the in-page map.
# Permit http://localhost:2000/* and http://127.0.0.1:2000/* for local use.
VITE_GOOGLE_MAPS_API_KEY=

# Public Web client key for the existing busprojectmmd Firebase project.
VITE_FIREBASE_API_KEY=

# Optional HTTPS reviews API base URL; defaults to the original service.
VITE_REVIEWS_API_URL=
